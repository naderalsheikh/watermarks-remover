# =============================================================
# ClearCounsel — environment configuration
# =============================================================
# QUICK START: copy this file to .env and fill in the values
# marked [REQUIRED]. Everything else has safe defaults.
# =============================================================

# --- PRODUCT SURFACE (CounselClear UI + wr-api) --------------

# [REQUIRED] API key for the LLM backend used by the airlock
OPENAI_API_KEY=

# Base URL for the LLM API (defaults to OpenAI; swap for
# any OpenAI-compatible endpoint, e.g. a local Ollama server)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use for AI-assisted provenance analysis
OPENAI_MODEL=gpt-4o

# Port the CounselClear Streamlit UI listens on
STREAMLIT_PORT=8501

# Secret used to sign session tokens in the Streamlit app
APP_SECRET_KEY=change-me-in-production

# --- WATERMARK REMOVAL CORE (wr-api) -------------------------

# Toggle verbose debug output from the removal pipeline
WR_DEBUG=false

# Maximum file size (bytes) the API will accept
WR_MAX_FILE_SIZE=104857600

# Number of parallel worker threads for batch jobs
WR_WORKERS=4

# --- RESEARCH / EVALUATION HARNESS (--profile upstream only) -
# The variables below are only needed if you run:
#   docker compose --profile upstream up
# Skip this section entirely for normal CounselClear use.

# Hugging Face token — needed to pull gated evaluation models
HF_TOKEN=

# Cache directory for downloaded models
HF_HOME=/root/.cache/huggingface

# Which watermarking schemes to include in the evaluation sweep
EVAL_SCHEMES=KGW,MPAC,SIR,UNIGRAM,XSIR

# Seed document used by seed-eval to bootstrap the corpus
SEED_EVAL_DOC=

# Output directory for evaluation artefacts
EVAL_OUTPUT_DIR=/app/eval_output

# Maximum tokens per chunk when splitting long documents
EVAL_MAX_CHUNK_TOKENS=512

# Sampling temperature for the evaluation LLM calls
EVAL_TEMPERATURE=0.0

# Number of evaluation trials per scheme
EVAL_TRIALS=3

# Log level for the evaluation harness
EVAL_LOG_LEVEL=INFO

# API endpoint for the upstream MarkLLM service (when profiled)
MARKLLM_API_URL=http://markllm-eval:8000

# Internal endpoint for the wr-core removal service
WR_API_URL=http://wr-api:8000

# Enable GPU acceleration in the evaluation containers (0=CPU)
CUDA_VISIBLE_DEVICES=0

# Docker image tag used for evaluation containers
EVAL_IMAGE_TAG=latest

# Registry prefix for evaluation images
IMAGE_REGISTRY=ghcr.io/naderalsheikh

# Build platform for evaluation images (leave blank for auto)
DOCKER_PLATFORM=

# Internal port for the MarkLLM evaluation service
MARKLLM_PORT=8000

# Internal port for the wr-core removal service
WR_PORT=8001
