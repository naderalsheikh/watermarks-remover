# Copy to .env for `docker compose` (docker compose auto-loads .env from the
# repo root). Everything here is optional — the core service works with no
# configuration at all.

# ---------------------------------------------------------------------------
# Core HTTP service (used by wr-core)
# ---------------------------------------------------------------------------
# Optional bearer token for the HTTP API. When set, every request must send
# `Authorization: Bearer <key>`.
WATERMARKS_SERVER_API_KEY=

# ---------------------------------------------------------------------------
# Vendor text-watermark detection (wr-core)
# ---------------------------------------------------------------------------
# (Retired Aug 2026) Google removed SynthID text watermarking from the
# Generative Language API; the gemini-synthid-text detector was removed.
# A vendor detector can be re-added here if Google exposes detection again.

# Optional MarkLLM research harness (host checkouts only; not in the core
# image). Same-config-only detection — not a vendor oracle.
# WATERMARKS_MARKLLM_DIR=~/MarkLLM
# WATERMARKS_MARKLLM_SCHEME=kgw           # kgw | synthid

# ---------------------------------------------------------------------------
# Harness / heavy backends (only used by the harness/heavy profiles)
# ---------------------------------------------------------------------------
# Optional Hugging Face token for gated models (CtrlRegen, MarkLLM,
# MarkDiffusion score models). Env only — never on argv.
HF_TOKEN=

# SynthID image scoring over HTTP (heavy profile): point wr-core at the
# wr-synthid-score sidecar and share the same bearer key on both sides.
# With the heavy profile up, uncomment:
# WATERMARKS_SYNTHID_SCORER_URL=http://wr-synthid-score:8766
# WATERMARKS_SYNTHID_SCORER_API_KEY=
# WATERMARKS_SYNTHID_SCORER_TIMEOUT=60

# ---------------------------------------------------------------------------
# CounselClear control plane (used by the `legal` compose profile: cc-api,
# cc-worker — service/app/, not the core watermark-remover service above)
# ---------------------------------------------------------------------------
# Required for the local-password login (the default auth mode) — hashed
# with argon2id into {data_root}/auth/local.hash on first boot; an existing
# hash file wins, so rotating the password is a deliberate act of deleting
# it. Not used at all when OIDC SSO is configured below.
COUNSELCLEAR_LOCAL_PASSWORD=

# Where matters/documents/jobs/the sqlite db live. Defaults to ./data
# outside a container; compose sets this to /data (the cc-data volume).
# COUNSELCLEAR_DATA_ROOT=./data

# Database backend. Empty (default) = embedded SQLite at
# {COUNSELCLEAR_DATA_ROOT}/counselclear.sqlite3 — fine for one API process.
# Set a SQLAlchemy URL to run against Postgres instead: required for more
# than one API replica, and the supported choice when state must outlive
# any single container. Object custody (originals/derivatives/bundles)
# stays on the filesystem either way.
#   External managed Postgres:
#     COUNSELCLEAR_DATABASE_URL=postgresql+psycopg://user:pass@db.internal:5432/counselclear
#   Bundled compose service (adds cc-postgres under the pg profile — also
#   set COUNSELCLEAR_PG_PASSWORD below):
#     COUNSELCLEAR_DATABASE_URL=postgresql+psycopg://counselclear:pass@cc-postgres:5432/counselclear
# COUNSELCLEAR_DATABASE_URL=

# Credentials for the bundled cc-postgres service (pg profile only; unused
# when COUNSELCLEAR_DATABASE_URL points elsewhere). Required when the pg
# profile is enabled. User/db default to counselclear/counselclear.
# COUNSELCLEAR_PG_USER=counselclear
# COUNSELCLEAR_PG_PASSWORD=
# COUNSELCLEAR_PG_DB=counselclear

# subprocess (default, and the legal compose profile's default too) or
# docker. subprocess runs each job as a plain child process of the API — no
# per-job container isolation, but works with no further setup. docker runs
# each job in a hardened, network-off container and REQUIRES
# COUNSELCLEAR_WORKER_IMAGE below to be set — without it, every job fails
# immediately with a clear "digest-pinned" error (it used to 500 and leave
# the job stuck at "running" forever; that's fixed, but the image still has
# to be pinned for jobs to run at all). Docker mode also requires cc-api
# itself to reach a Docker daemon — the shipped compose cc-api container has
# no docker CLI or socket (deliberately: mounting the host socket into it
# would give any cc-api compromise host-root-equivalent access). To use
# docker mode for real per-job isolation, run cc-api as a native host
# process instead of the containerized compose service — see
# docs/COUNSELCLEAR_PRODUCTION.md §3.
# COUNSELCLEAR_WORKER_MODE=docker

# Required when COUNSELCLEAR_WORKER_MODE=docker. Must be digest-pinned
# (repo@sha256:<64 hex>) — the runner refuses to run an unpinned image, by
# design (a mutable tag defeats the point of pinning what a worker runs).
# Build service/Dockerfile.counselclear and pin the digest it produces.
# COUNSELCLEAR_WORKER_IMAGE=

# Optional OCI runtime for the per-job worker container (docker mode only):
# e.g. "runsc" (gVisor) adds a userspace kernel between the document parser
# and the host kernel. The runtime must be registered with Docker on the
# host (see docs/COUNSELCLEAR_PRODUCTION.md §3). Empty = default runtime.
# COUNSELCLEAR_WORKER_RUNTIME=runsc

# Optional OIDC SSO (Phase 3). Set ISSUER + CLIENT_ID + CLIENT_SECRET to
# replace the shared local password with single sign-on (authorization-code
# flow; discovery is read from {ISSUER}/.well-known/openid-configuration).
# With OIDC on, /v1/auth/login is disabled and no password hash file is used.
# ALLOWED is fail-closed: a comma-separated list of emails or IdP subject
# values that may sign in — an empty list denies EVERYONE.
# COUNSELCLEAR_OIDC_ISSUER=https://idp.example.com
# COUNSELCLEAR_OIDC_CLIENT_ID=counselclear
# COUNSELCLEAR_OIDC_CLIENT_SECRET=
# COUNSELCLEAR_OIDC_ALLOWED=alice@example.com,bob@example.com
# Only needed behind a proxy where the callback URL differs from
# <request scheme://host>/v1/auth/oidc/callback as the IdP sees it:
# COUNSELCLEAR_OIDC_REDIRECT_URI=https://counselclear.example.com/v1/auth/oidc/callback

# Per-job wall-clock ceiling in seconds, for both subprocess and docker
# mode. Default 600. The actual timeout used is min(this, a Caps-derived
# budget for the job's kind), so lowering this can only make jobs time out
# *sooner*, never later than the engine's own budget.
# COUNSELCLEAR_WORKER_TIMEOUT_S=600

# Docs (/docs, /redoc, /openapi.json) are FAIL-CLOSED: they exist only when
# this is set to 1. Opt in for local development; never on a deployment
# reachable beyond loopback (the endpoints carry no auth check).
# COUNSELCLEAR_ENABLE_DOCS=1

# Login brute-force throttle: after N failed logins from one client address
# inside WINDOW seconds, that address is locked out for LOCKOUT seconds
# (even correct passwords are refused with 429). Defaults: 5 / 300 / 300.
# COUNSELCLEAR_LOGIN_MAX_FAILURES=5
# COUNSELCLEAR_LOGIN_WINDOW_S=300
# COUNSELCLEAR_LOGIN_LOCKOUT_S=300

# Set to 0 to silence per-request JSON access-log lines (startup posture
# lines stay). Default is on.
# COUNSELCLEAR_ACCESS_LOG=0

# Runtime ClamAV definitions directory. compose's legal profile mounts the
# cc-freshclam sidecar's shared volume at /clamav-defs and sets this — scans
# then use live definitions instead of the image's build-time seed. Unset or
# missing directory = build-time seed.
# COUNSELCLEAR_CLAMAV_DB_DIR=/clamav-defs

# ---------------------------------------------------------------------------
# CounselClear engine internals (rarely set directly; documented for
# completeness, not because a typical deployment needs them)
# ---------------------------------------------------------------------------
# Pins the processor.git_sha recorded in every manifest, instead of reading
# it from the checked-out git repo at runtime (which a container image
# usually doesn't have). Falls back to WATERMARKS_GIT_SHA, then "unknown".
# COUNSELCLEAR_GIT_SHA=

# Pins the processor.image_digest recorded in every manifest — set this to
# the running container's own digest (e.g. from the container runtime) so
# a manifest can prove exactly which image produced it.
# COUNSELCLEAR_IMAGE_DIGEST=

# Feature-flags the PDF render-and-compare verification step (warn-only;
# never a hard gate). Off by default until the bbox-mask/threshold
# calibration is validated against real firm documents. Requires poppler's
# `pdftoppm` on PATH (absent = silently skipped, manifest says so). The
# result lands in each manifest under verification.visual_compare.
# COUNSELCLEAR_VISUAL_COMPARE=0

# ---------------------------------------------------------------------------
# Client-side (used by the skill or curl, NOT by compose)
# ---------------------------------------------------------------------------
# Where to reach the service. Defaults to http://127.0.0.1:8765.
# WATERMARKS_SERVICE_URL=http://127.0.0.1:8765

# ---------------------------------------------------------------------------
# Layer B statistical-watermark rewrite (only for the rewrite_text.py hook,
# which runs inside the core image or a local checkout; the agent skill does
# Layer B itself with its own model and does not need these)
# ---------------------------------------------------------------------------
# WATERMARKS_REWRITE_BACKEND=ollama        # or: openai-compatible
# WATERMARKS_REWRITE_MODEL=llama3.2
# WATERMARKS_REWRITE_BASE_URL=http://127.0.0.1:11434
# WATERMARKS_REWRITE_API_KEY=              # env only, never on argv
# WATERMARKS_REWRITE_ALLOW_REMOTE=1        # only for non-loopback endpoints
# WATERMARKS_REWRITE_REASONING_EFFORT=none # none/low/medium/high, or off to omit
# WATERMARKS_REWRITE_CANDIDATES=1          # variants generated per evaluation round (default 1)
# WATERMARKS_REWRITE_LOOPS=1               # max evaluation rounds; retries new variants until one passes (default 1)
# WATERMARKS_REWRITE_STRENGTH=preserve     # preserve|legal (default, meaning-locked) or paraphrase/humanize/...
