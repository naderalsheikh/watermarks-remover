{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://counselclear.local/schemas/report.v1.schema.json",
  "title": "CounselClear Release Packet Report v1",
  "type": "object",
  "required": ["report_version", "verification", "findings_before"],
  "additionalProperties": false,
  "properties": {
    "report_version": { "const": 1 },
    "verification": {
      "type": ["object", "null"]
    },
    "findings_before": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    }
  }
}
