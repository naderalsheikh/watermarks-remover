{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://counselclear.local/schemas/report.v2.schema.json",
  "title": "CounselClear Release Packet Report v2",
  "version": 2,
  "type": "object",
  "required": ["report_version", "verification", "findings_before", "action_records"],
  "additionalProperties": false,
  "properties": {
    "report_version": { "const": 1 },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "_comment_optional": "not in required -- reports issued before 2026-08-31 carry no schema pin and must keep validating; names the published contract this report was built against"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "_comment_optional": "not in required -- reports issued before 2026-08-31 carry no schema pin and must keep validating; sha256 of the published report.schema.json file's bytes, recomputed by the offline verifier against the schema shipped next to it"
    },
    "verification": {
      "type": ["object", "null"]
    },
    "findings_before": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "action_records": { "type": "array", "items": { "$ref": "#/$defs/action_record" } }
  },
  "$defs": {
    "legal_justification": {
      "type": "object",
      "required": ["basis", "note"],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "unspecified",
            "attorney_client_privilege",
            "work_product_protection",
            "confidentiality_obligation",
            "trade_secret_or_proprietary",
            "privacy_or_data_protection",
            "outside_agreed_scope",
            "court_or_government_order",
            "legal_or_regulatory_restriction",
            "other",
            "privilege",
            "work_product",
            "pii_confidentiality",
            "relevance",
            "court_order",
            "client_instruction",
            "litigation_hold",
            "gdpr_access"
          ]
        },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "action_record": {
      "type": "object",
      "required": ["subtype", "action", "detail"],
      "additionalProperties": false,
      "properties": {
        "subtype": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "legal_justification": { "$ref": "#/$defs/legal_justification" },
        "retained_finding": {
          "type": "boolean",
          "_comment_optional": "schema v2; absent (== false) on v1 reports. Mirrors manifest.schema.json's field of the same name -- the finding was present before sanitization and survives into the derivative."
        }
      }
    }
  }
}
