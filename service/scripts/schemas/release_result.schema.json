{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://counselclear.local/schemas/release_result.v1.schema.json",
  "title": "CounselClear Release Result v1",
  "type": "object",
  "required": [
    "spec_version",
    "release_id",
    "job_id",
    "document_id",
    "matter_id",
    "status",
    "policy_id",
    "profile_id",
    "recipient_type",
    "recipient_name",
    "purpose",
    "intended_external",
    "reason",
    "original_sha256",
    "created_at",
    "finished_at",
    "audit_refs",
    "legal_justifications",
    "limitations",
    "certificate_html_sha256",
    "generated_at",
    "anchor"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": "1.0" },
    "release_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "matter_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["done", "refused", "failed"] },
    "policy_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "recipient_type": { "type": "string", "minLength": 1 },
    "recipient_name": { "type": "string" },
    "purpose": { "type": "string" },
    "intended_external": { "type": "boolean" },
    "reason": { "type": "string" },
    "attestation": {
      "enum": ["none", "signature_break_attested"],
      "_comment_optional": "not in required -- results issued before 2026-08-30 carry no attestation field and must keep validating"
    },
    "original_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": ["string", "null"] },
    "audit_refs": {
      "type": "object",
      "required": ["release_created_seq", "release_terminal_seq"],
      "additionalProperties": true,
      "properties": {
        "release_created_seq": { "type": "integer", "minimum": 1 },
        "release_terminal_seq": { "type": "integer", "minimum": 1 }
      }
    },
    "legal_justifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/legal_justification_record" }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "certificate_html_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "signature_ref": {
      "type": "object",
      "required": ["algorithm", "key_id", "signed_fields"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "signed_fields": { "const": "release_packet.v1.canonical" }
      },
      "_comment_optional": "not in required -- results issued before PR 57 carry no reference and must keep validating"
    },
    "anchor": {
      "type": "object",
      "required": ["type", "digest", "reference"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "digest": { "type": ["string", "null"] },
        "reference": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "legal_justification": {
      "type": "object",
      "required": ["basis", "note"],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "unspecified",
            "privilege",
            "work_product",
            "pii_confidentiality",
            "relevance",
            "court_order",
            "client_instruction",
            "litigation_hold",
            "gdpr_access",
            "other"
          ]
        },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "legal_justification_record": {
      "type": "object",
      "required": ["subtype", "action", "legal_justification"],
      "additionalProperties": false,
      "properties": {
        "subtype": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "legal_justification": { "$ref": "#/$defs/legal_justification" }
      }
    }
  }
}
