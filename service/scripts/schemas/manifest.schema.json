{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://counselclear.local/schemas/manifest.v1.schema.json",
  "title": "CounselClear Manifest v1",
  "type": "object",
  "required": [
    "manifest_version",
    "product",
    "original",
    "derivative",
    "policy",
    "processor",
    "actions",
    "action_records",
    "findings_before",
    "verification",
    "timestamps",
    "attestation_kind"
  ],
  "additionalProperties": true,
  "properties": {
    "manifest_version": { "const": 1 },
    "product": { "const": "counselclear" },
    "original": {
      "type": "object",
      "required": ["filename", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "derivative": {
      "type": "object",
      "required": ["filename", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "policy": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "processor": { "type": "object" },
    "actions": { "type": "array", "items": { "type": "string" } },
    "action_records": { "type": "array", "items": { "$ref": "#/$defs/action_record" } },
    "findings_before": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "object" },
    "timestamps": {
      "type": "object",
      "required": ["created_utc"],
      "additionalProperties": true,
      "properties": {
        "created_utc": { "type": "string", "minLength": 1 }
      }
    },
    "attestation_kind": {
      "enum": ["none", "signature_break_attested"]
    },
    "operator": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "matter": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "layer_b": { "type": "object" }
  },
  "$defs": {
    "legal_justification": {
      "type": "object",
      "required": ["basis", "note"],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "unspecified",
            "privilege",
            "work_product",
            "pii_confidentiality",
            "relevance",
            "court_order",
            "client_instruction",
            "litigation_hold",
            "gdpr_access",
            "other"
          ]
        },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "action_record": {
      "type": "object",
      "required": ["subtype", "action", "detail"],
      "additionalProperties": false,
      "properties": {
        "subtype": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "legal_justification": { "$ref": "#/$defs/legal_justification" }
      }
    }
  }
}
