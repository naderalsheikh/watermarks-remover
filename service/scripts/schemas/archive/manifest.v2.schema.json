{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://counselclear.local/schemas/manifest.v2.schema.json",
  "title": "CounselClear Manifest v2",
  "version": 2,
  "type": "object",
  "required": [
    "manifest_version",
    "product",
    "original",
    "derivative",
    "policy",
    "processor",
    "actions",
    "action_records",
    "findings_before",
    "verification",
    "timestamps",
    "attestation_kind"
  ],
  "additionalProperties": true,
  "properties": {
    "manifest_version": { "const": 1 },
    "product": { "const": "counselclear" },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "_comment_optional": "not in required -- manifests issued before 2026-08-31 carry no schema pin and must keep validating; names the published contract this manifest was built against"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "_comment_optional": "not in required -- manifests issued before 2026-08-31 carry no schema pin and must keep validating; sha256 of the published manifest.schema.json file's bytes, recomputed by the offline verifier against the schema shipped next to it"
    },
    "original": {
      "type": "object",
      "required": ["filename", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "derivative": {
      "type": "object",
      "required": ["filename", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "policy": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "processor": { "type": "object" },
    "actions": { "type": "array", "items": { "type": "string" } },
    "action_records": { "type": "array", "items": { "$ref": "#/$defs/action_record" } },
    "residual_metadata": {
      "type": "object",
      "required": ["stripped", "retained"],
      "additionalProperties": false,
      "properties": {
        "stripped": { "type": "array", "items": { "type": "string" } },
        "retained": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "reason"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "reason": { "type": "string" }
            }
          }
        }
      },
      "_comment_optional": "schema v2; not in required. The policy's explicit position on authoring exhaust that is neither a finding nor identity metadata -- RSIDs, persistent document ids, session timestamps and counters. A policy that is SILENT about these is the defect; this field makes the silence impossible."
    },
    "dispositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/disposition" },
      "_comment_optional": "schema v2; not in required -- v1 manifests carry no disposition ledger and must keep validating. One entry per subtype PRESENT before sanitization: finding -> policy decision -> post-sanitize observation, so no reader has to infer which stripping operation disposed of which pre-sanitize finding."
    },
    "findings_before": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "object" },
    "timestamps": {
      "type": "object",
      "required": ["created_utc"],
      "additionalProperties": true,
      "properties": {
        "created_utc": { "type": "string", "minLength": 1 }
      }
    },
    "attestation_kind": {
      "enum": ["none", "signature_break_attested"]
    },
    "operator": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "matter": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "layer_b": { "type": "object" }
  },
  "$defs": {
    "legal_justification": {
      "type": "object",
      "required": ["basis", "note"],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "unspecified",
            "privilege",
            "work_product",
            "pii_confidentiality",
            "relevance",
            "court_order",
            "client_instruction",
            "litigation_hold",
            "gdpr_access",
            "other"
          ]
        },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "action_record": {
      "type": "object",
      "required": ["subtype", "action", "detail"],
      "additionalProperties": false,
      "properties": {
        "subtype": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" },
        "legal_justification": { "$ref": "#/$defs/legal_justification" },
        "retained_finding": {
          "type": "boolean",
          "_comment_optional": "schema v2; absent (== false) on v1 manifests. true means this record documents a finding that was PRESENT before sanitization and SURVIVES into the derivative. Every such record must produce a certificate limitation -- see main.py _build_certificate_html."
        }
      }
    },
    "disposition": {
      "type": "object",
      "required": ["subtype", "present_before", "action", "reason", "present_after", "postcondition"],
      "additionalProperties": false,
      "properties": {
        "subtype": { "type": "string", "minLength": 1 },
        "present_before": { "type": "boolean" },
        "action": { "type": "string", "minLength": 1 },
        "reason": { "type": ["string", "null"] },
        "present_after": {
          "type": ["boolean", "null"],
          "_comment": "null when the post-sanitize re-inspect could not observe this subtype either way"
        },
        "postcondition": {
          "enum": [
            "removed_confirmed",
            "retained_as_planned",
            "retained_unplanned",
            "not_verifiable"
          ]
        },
        "legal_basis": { "type": ["string", "null"] }
      }
    }
  }
}
