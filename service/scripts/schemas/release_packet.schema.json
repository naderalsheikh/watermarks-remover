{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://counselclear.local/schemas/release_packet.v2.schema.json",
  "title": "CounselClear Release Packet v2",
  "version": 2,
  "type": "object",
  "required": [
    "spec_version",
    "packet_id",
    "release_id",
    "matter_id",
    "document_id",
    "job_id",
    "original_sha256",
    "kind",
    "status",
    "policy",
    "hashes",
    "audit_refs",
    "legal_justifications",
    "limitations",
    "generated_at",
    "generated_by",
    "anchor"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": "1.0" },
    "packet_id": { "type": "string", "minLength": 1 },
    "release_id": { "type": ["string", "null"] },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "_comment_optional": "not in required -- packets issued before 2026-08-31 carry no schema pin and must keep validating; names the published contract this packet was built against"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "_comment_optional": "not in required -- packets issued before 2026-08-31 carry no schema pin and must keep validating; sha256 of the published release_packet.schema.json file's bytes, recomputed by the offline verifier against the schema shipped next to it"
    },
    "release": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string" },
        "recipient_type": { "type": "string" },
        "recipient_name": { "type": "string" },
        "purpose": { "type": "string" },
        "intended_external": { "type": "boolean" }
      }
    },
    "matter_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "original_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "kind": { "enum": ["sanitize"] },
    "status": { "enum": ["done", "refused", "failed"] },
    "attestation": {
      "enum": ["none", "signature_break_attested"],
      "_comment_optional": "not in required -- packets issued before 2026-08-30 carry no attestation field and must keep validating"
    },
    "predecessor_release_id": {
      "type": "string",
      "minLength": 1,
      "_comment_optional": "SHOULD-4 (review 2026-08-30): present only on a packet whose release re-runs an earlier release of the same document; not in required -- first releases and pre-2026-08-30 packets carry no such field and must keep validating"
    },
    "policy": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": ["string", "null"] },
        "version": { "type": ["integer", "null"], "minimum": 1 },
        "digest": { "type": ["string", "null"] }
      }
    },
    "hashes": {
      "type": "object",
      "required": [
        "derivative",
        "manifest_json_sha256",
        "report_json_sha256",
        "certificate_html_sha256",
        "readme_txt_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "derivative": {
          "type": "object",
          "required": ["filename", "sha256"],
          "additionalProperties": false,
          "properties": {
            "filename": { "type": ["string", "null"] },
            "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "manifest_json_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "report_json_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "certificate_html_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "readme_txt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "audit_refs": {
      "type": "object",
      "required": ["bundle_download_seq", "certificate_issued_seq"],
      "additionalProperties": true,
      "properties": {
        "bundle_download_seq": { "type": "integer", "minimum": 1 },
        "certificate_issued_seq": { "type": "integer", "minimum": 1 }
      }
    },
    "legal_justifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/legal_justification_record" }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string", "minLength": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "signature": {
      "type": "object",
      "required": ["algorithm", "key_id", "signed_fields", "digest", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "signed_fields": {
          "enum": [
            "release_packet.v1.canonical",
            "release_packet.v1.canonical-excluding-anchor"
          ],
          "_comment": "schema v2 fix: this was a const naming only the first value, so every SUCCESSFULLY TSA-anchored packet failed its own published schema. The anchor-excluding variant is emitted whenever an RFC 3161 token is obtained (security.PACKET_SIGNATURE_SIGNED_FIELDS_EXCLUDING_ANCHOR), because the anchor's digest IS the signature's sha256 and so cannot be inside the bytes it signs. The bug was latent because a packet only takes that path when the TSA actually answers."
        },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "_comment_optional": "schema v2; absent on packets issued before 2026-09-05. Raw Ed25519 public bytes, published so a recipient who lost the operator's key file can still check the signature. Solves AVAILABILITY only: anyone able to alter the packet could also replace this field, so a verifier must never report a check against it with the same word it uses for an operator-supplied key. See docs/counselclear-key-durability-proposal.md §1a."
        }
      },
      "_comment_optional": "not in required -- packets issued before PR 57 carry no signature and must keep validating"
    },
    "anchor": {
      "type": "object",
      "required": ["type", "digest", "reference"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string" },
        "digest": { "type": ["string", "null"] },
        "reference": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "legal_justification": {
      "type": "object",
      "required": ["basis", "note"],
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "unspecified",
            "attorney_client_privilege",
            "work_product_protection",
            "confidentiality_obligation",
            "trade_secret_or_proprietary",
            "privacy_or_data_protection",
            "outside_agreed_scope",
            "court_or_government_order",
            "legal_or_regulatory_restriction",
            "other",
            "privilege",
            "work_product",
            "pii_confidentiality",
            "relevance",
            "court_order",
            "client_instruction",
            "litigation_hold",
            "gdpr_access"
          ]
        },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "legal_justification_record": {
      "type": "object",
      "required": ["subtype", "action", "legal_justification"],
      "additionalProperties": false,
      "properties": {
        "subtype": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "legal_justification": { "$ref": "#/$defs/legal_justification" }
      }
    }
  }
}
