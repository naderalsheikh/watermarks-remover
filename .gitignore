# Deny by default: only what is explicitly allowed below can be added to git.
# Local test artifacts, secrets (.env), and tooling stay out without a rule
# for each one. Tracked files are unaffected.
/*
!/.github/
!/.github/**
!/benchmarks/
!/benchmarks/**
!/docs/
!/docs/**
!/deploy/
!/deploy/**
!/engine/
!/engine/__init__.py
!/engine/schemas/
!/engine/schemas/**
!/service/
!/service/**
!/skills/remove-ai-marks/
!/skills/remove-ai-marks/**
!/tests/
!/tests/**
!/web/
!/web/**
!/.dockerignore
!/.env.example
!/.gitignore
!/.pre-commit-hooks.yaml
!/CODE_OF_CONDUCT.md
!/compose-check.sh
!/compose.yaml
!/CONTRIBUTING.md
!/LICENSE
!/Makefile
!/pytest.ini
!/README.md
!/requirements-dev.txt
!/ruff.toml
!/SECURITY.md

# Exceptions even inside allowed trees
.env
**/__pycache__/
*.pyc
.venv/
.firecrawl/
.figlet/
posts.md
*.cleaned.*
*.bak
.kgw-key
web/node_modules/
web/.next/
web/out/
web/*.tsbuildinfo
web/next-env.d.ts
